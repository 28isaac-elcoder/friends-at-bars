VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Same MapKit JS token as the main Bar Fest app (Apple Developer → Maps → MapKit JS).
# Local: set in .env.local. Vercel CMS project: Environment Variables → VITE_MAPKIT_TOKEN.
# Allowlist localhost:5174 and your Vercel CMS domain on the token.
VITE_MAPKIT_TOKEN=
